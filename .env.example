# Runtime database connection: Supabase transaction pooler (port 6543).
# Percent-encode reserved characters in the password.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migration database connection: Supabase session pooler (port 5432).
# Percent-encode reserved characters in the password.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# Server-only. Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY="sb_secret_your_key"

# Document processing providers. These values are server-only.
OPENAI_API_KEY="sk-your-key"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="signkey-your-inngest-signing-key"

# Private Supabase Storage bucket and per-owner source-file quota.
DOCUMENTS_BUCKET="documents"
DOCUMENT_STORAGE_QUOTA_BYTES="104857600"
