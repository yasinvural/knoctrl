# Runtime database connection: Supabase transaction pooler (port 6543).
# Percent-encode reserved characters in the password.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migration database connection: Supabase session pooler (port 5432).
# Percent-encode reserved characters in the password.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# Server-only. Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY="sb_secret_your_key"
